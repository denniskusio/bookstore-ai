# Copy to .env to override the defaults used by docker-compose.yml. Every value is optional.
# These are local-development defaults, not secrets - never reuse them anywhere real.

POSTGRES_USER=bookstore
POSTGRES_PASSWORD=bookstore

# Models pulled by the ollama-init step and used by the assistant-service.
# Changing the embedding model also changes the vector dimension: adjust the Flyway migration and
# spring.ai.vectorstore.pgvector.dimensions in the assistant-service accordingly.
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
